{
    "name": "tensicai/php-sdk",
    "description": "PHP Tensic AI SDK",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Arne De Smedt",
            "email": "arne.desmedt@team.blue"
        }
    ],
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5",
        "team-blue/java-openapi-codegen-php-client": "^3.3",
        "team-blue/php-json-immutable-objects": "^1.0"
    },
    "require-dev": {
        "team-blue/php-client-mock": "^2.0",
        "doctrine/coding-standard": "~11.0",
        "phpmd/phpmd": "~2.0",
        "phpro/grumphp": "~2.0",
        "phpstan/phpstan": "~2.0",
        "rector/rector": "~2.0",
        "squizlabs/php_codesniffer": "~3.0"
    },
    "autoload": {
        "psr-4": {
            "TensicAI\\SDK\\": ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true
        },
        "sort-packages": true
    },
    "scripts-descriptions": {
        "tests": "Run all tests"
    },
    "scripts": {
        "tests": [
            "vendor/bin/phpcbf",
            "vendor/bin/phpcs -d memory_limit=512M",
            "vendor/bin/phpstan analyze --no-progress --memory-limit 512M",
            "vendor/bin/phpmd . text phpmd.xml --exclude vendor,resources,.openapi-generator",
            "vendor/bin/rector --dry-run --no-progress-bar"
        ]
    }
}
